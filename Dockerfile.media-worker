FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm db:generate && pnpm exec turbo build --filter=@saathi/api...
RUN mkdir -p /app/.data && chown node:node /app/.data
ENV NODE_ENV=production SERVICE_ROLE=media-worker MEDIA_PROCESSING_MODE=worker
USER node
CMD ["node", "apps/api/dist/apps/api/src/media/worker.js"]

{
  "name": "saathi",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:packages && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @saathi/database generate",
    "db:migrate": "pnpm --filter @saathi/database migrate",
    "db:check": "pnpm --filter @saathi/database check",
    "db:seed": "pnpm --filter @saathi/database seed",
    "build:packages": "turbo build --filter=./packages/*",
    "db:local": "node scripts/local-postgres.mjs",
    "spike:nearby": "node scripts/nearby-spike.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.3",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "sharp": "0.34.5",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}

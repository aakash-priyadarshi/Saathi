NODE_ENV=development
DATABASE_URL=postgresql://saathi:saathi_local@localhost:5432/saathi?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
PUBLIC_URL=http://localhost:3000
PLATFORM_NAME=Saathi
NEXT_PUBLIC_PLATFORM_NAME=Saathi
# Production requires a stable P-256 private JWK in the secret manager for signed sync receipts.
# Development keeps a generated local key in .data; never commit or distribute private keys.
SYNC_SIGNING_PRIVATE_JWK=
REQUEST_ID_PREFIX=SAA
RESERVATION_MINUTES=20
SESSION_DAYS=7
# Local seed password is mandatory. Never use demo credentials in production.
SEED_PASSWORD=Saathi-demo-2026!
DEMO_MODE=true
# production: resend; local: log (durable notifications visible in database)
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Saathi <help@example.org>
# S3-compatible storage; public derivatives and private originals use separate buckets.
STORAGE_PROVIDER=s3
LOCAL_MEDIA_DIR=.data/media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=saathi_local
S3_SECRET_KEY=saathi_local_storage
S3_PRIVATE_BUCKET=saathi-originals
S3_PUBLIC_BUCKET=saathi-public
S3_PUBLIC_URL=http://localhost:9000/saathi-public
# production: clamav; local: disabled (local only; production refuses this)
MEDIA_SCAN_PROVIDER=disabled
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
FFMPEG_PATH=ffmpeg

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Nearby join an Android phone's Wi-Fi hotspot for fast transfers. Paid team only, so free-team builds leave it out. -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<!-- Universal Links: https://swarm.cockroachjantaparty.org/join#… opens Swarm. Needs the Team ID in apps/web apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:swarm.cockroachjantaparty.org</string>
	</array>
</dict>
</plist>
